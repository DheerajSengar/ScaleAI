# OpenAI-compatible chat completions. Keep provider keys server-only.
# For OpenRouter, use https://openrouter.ai/api/v1 and model openrouter/free.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Supabase project URL and browser publishable key.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase project API Keys page: publishable key (preferred) or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (preferred) or legacy service_role key. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
# Optional legacy fallbacks:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email enquiry notifications
LEAD_NOTIFICATION_EMAIL=dheerajsengar2004@gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Recommended for Vercel/Production: Resend HTTPS API avoids SMTP blocks.
RESEND_API_KEY=
LEAD_EMAIL_FROM="SCALE AI Enquiries <onboarding@resend.dev>"
